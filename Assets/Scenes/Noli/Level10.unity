  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 62 \u2013 Sa Kumbento"
    sprite: {fileID: -6455050014841698326, guid: d0370e0b2dc3b714c84687de39f99373, type: 3}
    imageDescription: ' Kapangyarihan ng mga Pari'
    description: "Ang buhay ni Maria Clara ay malinaw na patunay sa lawak ng kapangyarihan
      ng mga prayle sa panahon ng Kastila. Isang salita lang nila, at maaaring magbago
      ang kinabukasan ng isang tao\u2014kasal, reputasyon, kalayaan, pati na ang
      pangarap. Pinakita ni Rizal kung paano nagiging sandata ang relihiyon sa kamay
      ng mga makapangyarihang tao, at kung paano nito maaaring ipitin ang isang inosenteng
      babae na tulad ni Maria Clara."
  affectedObjects:
    container: []
  activatedObjects:
    container: []
