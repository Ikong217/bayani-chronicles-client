  scrollContent:
    title: "Kabanata 1 \u2013 Sa Ibabaw ng Kubyerta"
    sprite: {fileID: 2882146333287477088, guid: 2a595d022dc9d8e478afd9f32d19f65b, type: 3}
    imageDescription: Bapor Tabo at Lipunang Kolonyal
    description: "Ang Bapor Tabo ay hindi lamang barko \u2014 ito ay alegorya ng
      lipunang Pilipino sa ilalim ng kolonyal na pamahalaan. Ito ay maganda at makintab
      sa labas, ngunit bulok at mabagal sa loob. Sa barkong ito, sakay ang mga prayle,
      opisyal, at mamamayan \u2014 nag-aaway sa ideya ngunit walang konkretong aksyon."
  affectedObjects:
    container: []
  activatedObjects:
    container: []
