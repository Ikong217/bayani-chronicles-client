  m_Script: {fileID: 11500000, guid: f821fb8e30865e844b03fba045f67a1a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 39 \u2013 Si Simoun"
    sprite: {fileID: 5931915480054915164, guid: 5c8889677b3713f4289f42f898f63962, type: 3}
    imageDescription: Ang Kabiguan ni Simoun
    description: 'Nabigo si Simoun hindi dahil sa kanyang plano, kundi dahil sa kanyang
      puso.

      Ang kanyang galit ay nagdilim sa kanyang kaisipan, at hindi niya
      napagtanto na ang tunay na rebolusyon ay moral, hindi marahas.

      Sa pagkabigong
      ito, ipinakita ni Rizal ang babala laban sa poot na hindi ginabayan ng kabutihan.'
  affectedObjects:
    container: []
  activatedObjects:
    container: []
