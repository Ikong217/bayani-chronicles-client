  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 10 \u2013 Kayamanan at Karalitaan"
    sprite: {fileID: -8973685433085253168, guid: 49d144ebdf290334f92f36a53a39c343, type: 3}
    imageDescription: ' Kayamanan Bilang Panlilinlang'
    description: "Ginamit ni Simoun ang kanyang kayamanan bilang sandata. Hindi ito
      para sa karangyaan, kundi para makuha ang loob ng mga makapangyarihan at pabagsakin
      sila mula sa loob. Ang kanyang alahas ay naging simbolo ng panlilinlang at
      paghihiganti \u2014 katumbas ng mga mamahaling pangakong walang laman sa lipunan.\r\n"
  affectedObjects:
    container: []
  activatedObjects:
    container: []
