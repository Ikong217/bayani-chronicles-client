  m_Script: {fileID: 11500000, guid: f821fb8e30865e844b03fba045f67a1a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 64 \u2013 Wakas"
    sprite: {fileID: -8784477650698931936, guid: c16f72678389de345a50275642eb1863, type: 3}
    imageDescription: Tahimik na Kamatayan ni Elias
    description: "Walang sinumang nakasaksi sa huling paghinga ni Elias, ngunit ang
      katahimikan ng kanyang kamatayan ay nagsilbing pinakamalakas na simbolo ng
      nobela. Siya ay isang taong walang kapangyarihan, walang kayamanan, at walang
      pormal na edukasyon, pero sa pinakahuling sandali, siya ang nagligtas sa kinabukasan
      ng bayan sa pamamagitan ng pagligtas kay Ibarra. Pinakita ni Rizal na minsan
      ang tunay na bayani ay yaong hindi nakasulat sa kasaysayan\u2014yung kumikilos
      nang walang kapalit at nalilimutan ng lipunan matapos mag-sakripisyo."
  affectedObjects:
    container:
    - {fileID: 2110244527}
  activatedObjects:
    container:
    - {fileID: 1022269659}
