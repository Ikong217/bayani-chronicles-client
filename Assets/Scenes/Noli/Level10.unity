  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: " Kabanata 61 \u2013 Kasawian at Kalungkutan"
    sprite: {fileID: -4246156734027616742, guid: ae1459769ab44444393f9c55bf00aa04, type: 3}
    imageDescription: Hulog ng Loob ni Capitan Tiago
    description: "Ang biglang pagkalugmok ni Capitan Tiago sa depresyon ay hindi
      lang personal na pagkabagsak. Simbolo ito ng tao na buong-buhay kumiling sa
      mga prayle para sa seguridad at posisyon, ngunit sa huli, sila rin ang bumaling
      sa kanya. Tinuruan ni Rizal ang mambabasa na ang taong nakikinabang sa maling
      sistema ay maaaring siya ring maging biktima nito\u2014unti-unting nasisira,
      hindi dahil sa kahinaan lang, kundi dahil wala siyang sariling panindigan."
  affectedObjects:
    container:
    - {fileID: 555913027}
  activatedObjects:
    container:
    - {fileID: 1893606812}
