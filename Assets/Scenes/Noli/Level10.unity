  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 64 \u2013 Wakas"
    sprite: {fileID: 666633315044439073, guid: 4a6afdcfaf3efbc438e6f61be8b55297, type: 3}
    imageDescription: Martir na Nalimutang Sandali
    description: "Sa buong nobela, si Elias ang karakter na kumikilos mula sa puso,
      hindi mula sa pribilehiyo. Tahimik lang siya, ngunit malalim ang prinsipyo
      at pananaw sa pagbabago. Sa kanyang huling sakripisyo, ipinapakita ni Rizal
      na minsan ang pinakamahalagang kontribusyon ay hindi laging nakikita o ipinagdiriwang.
      Ang katotohanan: kung wala si Elias, wala ring Ibarra na makakaligtas\u2014at
      walang aral na magpapatuloy.\r\n"
  affectedObjects:
    container: []
  activatedObjects:
    container: []
