  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 24 \u2013 Sa Kagubatan"
    sprite: {fileID: -5925851634452128385, guid: a98534e2e4c3f184c80fc46e559ce8b3, type: 3}
    imageDescription: Maria Clara
    description: "Si Maria Clara ay simbolo ng kababaihang Pilipina sa ilalim ng
      kolonyalismo \u2014 relihiyosa, mapagmahal, ngunit walang kalayaan sa sarili.
      Sa pamamagitan niya, ipinakita ni Rizal ang kawalang-boses ng kababaihan at
      kung paanong ginagamit ng lipunan ang relihiyon upang ikulong ang kanilang
      damdamin. Gayunpaman, si Maria Clara rin ay sagisag ng kadalisayan at katatagan
      sa gitna ng pagkakasala ng lipunan."
  affectedObjects:
    container: []
  activatedObjects:
    container:
    - {fileID: 881826880}
