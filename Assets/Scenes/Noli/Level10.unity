  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 64 \u2013 Wakas"
    sprite: {fileID: -8016225347975602024, guid: dbf9a9996229f6c458c11d4c8d26babd, type: 3}
    imageDescription: Pamana ng Noli
    description: "Sa pagtatapos ng nobela, malinaw na hindi ito tungkol sa pag-ibig
      lang, ni hindi ito tungkol sa pagkatalo o tagumpay ng mga tauhan. Ito ay kwento
      ng paggising\u2014isang paanyaya ni Rizal sa mambabasa na makita ang tunay
      na sugat ng bayan. Ang \u201CNoli Me T\xE1ngere\u201D ay pamana ng mulat na
      pag-iisip, hindi para matapos basahin, kundi para simulan ang pag-unawa sa
      kasaysayan at kung bakit kailangang ipaglaban ang pagbabago.\r\n"
  affectedObjects:
    container:
    - {fileID: 2006982769}
  activatedObjects:
    container:
    - {fileID: 1335488419}
