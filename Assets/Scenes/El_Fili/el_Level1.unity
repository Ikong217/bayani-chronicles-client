  scrollContent:
    title: "Kabanata 19 \u2013 Ang Lambal (The Fuse)"
    sprite: {fileID: 2203467670470021903, guid: 7be6f80b38c69ae47b7e37b8f3b11ecc, type: 3}
    imageDescription: ' Pag-apoy ng Damdamin'
    description: "Habang umuusad ang nobela, dahan-dahang lumalakas ang sigaw ng
      pagbabago. Ang mga kabataan, tulad nina Isagani at Basilio, ay nagsisilbing
      \u201Capoy\u201D na magpapaliyab sa damdaming makabayan ng mga Pilipino. Si
      Simoun naman ang \u201Cgatilyo\u201D ng poot na gustong magpasabog ng sistemang
      bulok."
  affectedObjects:
    container: []
  activatedObjects:
    container: []
