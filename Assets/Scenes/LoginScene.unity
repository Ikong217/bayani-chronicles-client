      m_Calls: []
  m_text: "\tWelcome to Bayani Chronicles, a 2D Android game application designed
    to help Filipino students learn about Jos\xE9 Rizal\u2019s novels Noli Me Tangere
    and El Filibusterismo through interactive gameplay. Teachers and administrators
    may use the admin interface to monitor student progress and scores. This application
    is a capstone (thesis) project.\r\n\r\nTo maintain fairness and security, users
    must:\r\n\r\n    -Use only their own account (no multiple accounts per person).\r\n   
    -Avoid playing on another user\u2019s account.\r\n    -Administrators must supply
    a valid email for each user because login requires a One-Time Password (OTP).\r\n   
    -There is currently no logout mechanism to discourage account switching.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
