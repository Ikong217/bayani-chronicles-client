          tartgetLocation: {fileID: 1745782408}
          direction: 0
          walk: 1
          camFollow: 0
          cooldown: 0
      setEmotes:
        emotions:
        - player: 0
          character: {fileID: 1240681466}
          emotes: 0
          duration: 0
      questions:
        fromDatabase: 0
        questions:
          questions: []
        cycle: 1
        isOneTime: 0
        DeductTime: 0
      eventType: 2
      interval: 0
    - dialogue:
        dialogueLines:
        - characterObj: {fileID: 1240681466}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 0}
          dialogueType: 0
          line: Magandang araw, Bayani! Ngayon ay sisimulan natin ang Ikaapat bahagi
            ng iyong paglalakbay sa Noli Me Tangere. Tatalakayin natin ang mahahalagang
            pangyayari mula Kabanata 21 hanggang 28
      setLocation:
        setLocatoins: []
      setEmotes:
        emotions: []
      questions:
        fromDatabase: 0
        questions:
          questions: []
        cycle: 1
        isOneTime: 0
        DeductTime: 0
      eventType: 0
      interval: 0
    - dialogue:
        dialogueLines:
        - characterObj: {fileID: 1240681466}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 0}
          dialogueType: 0
          line: Good day, class!
        - characterObj: {fileID: 1240681466}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 0}
          dialogueType: 0
          line: "Today, we are going to talk about a very interesting and important
            topic \u2014 the thematic analysis of Chapters 1 to 5 of Noli Me Tangere.
            This lesson is important because it helps us understand not only the
            story, but also the social issues and historical realities that Rizal
            wanted to expose during his time"
      setLocation:
        setLocatoins:
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 1709749572}
          direction: 1
          walk: 1
          camFollow: 0
          cooldown: 0
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 218947779}
          direction: 1
          walk: 1
          camFollow: 0
          cooldown: 0
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 1745782408}
          direction: 1
          walk: 1
          camFollow: 0
          cooldown: 0
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 1745782408}
          direction: 2
          walk: 0
          camFollow: 0
          cooldown: 0
      setEmotes:
        emotions: []
      questions:
        fromDatabase: 0
        questions:
          questions: []
        cycle: 1
        isOneTime: 0
        DeductTime: 0
      eventType: 1
      interval: 1
    - dialogue:
        dialogueLines:
        - characterObj: {fileID: 1240681466}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 7096670327494543431, guid: 1189e97e912249f40a9ba9cf596f1aea, type: 3}
          dialogueType: 0
          line: "Magandang araw, Bayani! Sa mga kabanatang ito, mas lumalalim ang
            pagkamulat ni Ibarra sa mapait na katotohanan ng lipunan. Mula sa kanyang
            mga karanasan at pagkikita kay Elias, unti-unti niyang nauunawaan ang
            mga ugat ng kawalang-katarungan \u2014 ang katiwalian ng pamahalaan,
            ang pang-aabuso ng simbahan, at ang paghihirap ng mga karaniwang mamamayan."
      setLocation:
        setLocatoins:
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 1709749572}
          direction: 0
          walk: 1
          camFollow: 0
          cooldown: 0
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 218947779}
          direction: 0
          walk: 1
          camFollow: 0
          cooldown: 0
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 1745782408}
          direction: 0
          walk: 1
          camFollow: 0
          cooldown: 0
      setEmotes:
        emotions: []
      questions:
        fromDatabase: 0
        questions:
          questions: []
        cycle: 1
        isOneTime: 0
        DeductTime: 0
      eventType: 0
      interval: 0
    - dialogue:
        dialogueLines:
        - characterObj: {fileID: 1240681466}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 4146786208365501868, guid: 6b8a89486381421459187cd7f5324079, type: 3}
          dialogueType: 1
          line: "Ang kanilang pag-uusap ay isang intelektuwal na labanan ng dalawang
            ideolohiya \u2014 edukasyon laban sa rebolusyon. Sa kabila ng kanilang
            pagkakaiba, pareho silang naglalayong wakasan ang pang-aabuso. Ipinapakita
            nito na may iba\u2019t ibang paraan upang magmahal at maglingkod sa bayan."
        - characterObj: {fileID: 1240681466}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 1335385452945238478, guid: ab76748af06a70048b9e3096936b90f3, type: 3}
          dialogueType: 1
          line: Ang eksenang ito ay tanda ng pagkawala ng inosensiya ni Ibarra. Sa
            kanyang pagkakatuklas sa kasinungalingan laban sa kanyang ama, nagising
            siya sa maruming sistema ng lipunan. Ito ang simula ng kanyang pagkamulat
            at pagkakaroon ng kamalayang panlipunan.
        - characterObj: {fileID: 1240681466}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 4633355498211079068, guid: 35a9ca4ff72a2604384c37532bfa9f39, type: 3}
          dialogueType: 1
          line: "Ang bayan ng San Diego ay microcosm ng buong bansa \u2014 hati sa
            pagitan ng mayaman at mahirap, makapangyarihan at inaapi. Dito ipinakita
            ni Rizal kung gaano kalalim ang ugat ng katiwalian, at kung bakit nagiging
            mahirap ang katarungan sa ilalim ng mapang-aping sistema"
      setLocation:
        setLocatoins:
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 1709749572}
          direction: 0
          walk: 1
          camFollow: 0
          cooldown: 0
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 218947779}
          direction: 0
          walk: 1
          camFollow: 0
          cooldown: 0
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 1745782408}
          direction: 0
          walk: 1
          camFollow: 0
          cooldown: 0
      setEmotes:
        emotions: []
      questions:
        fromDatabase: 0
        questions:
          questions: []
        cycle: 1
        isOneTime: 0
        DeductTime: 0
      eventType: 0
      interval: 0
    - dialogue:
        dialogueLines:
        - characterObj: {fileID: 1240681466}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 7096670327494543431, guid: 1189e97e912249f40a9ba9cf596f1aea, type: 3}
