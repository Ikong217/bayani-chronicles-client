  scrollContent:
    title: "Kabanata 23 \u2013 Isang Bangkay"
    sprite: {fileID: 2882146333287477088, guid: c537ade8de99fb84bba2302a45ed5d9f, type: 3}
    imageDescription: Elias
    description: "Si Elias ay representasyon ng masang Pilipino \u2014 mahirap, walang
      pinag-aralan, ngunit puno ng malasakit at tapang. Siya ay larawan ng pag-asa
      ng mga inaapi, handang magbuwis ng buhay para sa bayan kahit hindi makilala.
      Ipinapakita ni Rizal na ang tunay na bayani ay hindi laging may kapangyarihan,
      kundi may pusong handang mag-alay para sa iba."
  affectedObjects:
    container: []
  activatedObjects:
    container:
    - {fileID: 280445190}
