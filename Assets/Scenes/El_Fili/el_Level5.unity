  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 627c1c2bfea08a54997d89f353dc3858, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  setEvents:
    events:
    - dialogue:
        dialogueLines:
        - characterObj: {fileID: 744502771}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 7096670327494543431, guid: 1189e97e912249f40a9ba9cf596f1aea, type: 3}
          dialogueType: 0
          line: Now you need to collect scroll before taking the quiz
      setLocation:
        setLocatoins:
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 875644703}
          direction: 0
