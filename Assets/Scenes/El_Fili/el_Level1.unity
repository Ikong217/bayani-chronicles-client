    - dialogue:
        dialogueLines:
        - characterObj: {fileID: 907261759}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 4146786208365501868, guid: 1a5dc180f96a322428b45ad5c8629374, type: 3}
          dialogueType: 1
          line: "Sa kabanatang ito ipinakilala si Simoun \u2014 ang dating Ibarra
            na bumalik bilang simbolo ng poot at paghihiganti. Ang Bapor Tabo ay
            kumakatawan sa lipunang Pilipino: maganda sa panlabas ngunit bulok sa
            kalooban."
        - characterObj: {fileID: 907261759}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 1335385452945238478, guid: 343cce93a4f7f984f8e4d0870a2c3f2a, type: 3}
          dialogueType: 1
          line: 'Ginamit ni Simoun ang kanyang yaman at impluwensya upang manipulahin
            ang mga makapangyarihan. Ang kanyang layunin ay malinaw: gamitin ang
            kasakiman ng mga prayle bilang sandata laban sa kanila.



'
        - characterObj: {fileID: 907261759}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 4633355498211079068, guid: 89a8e5e4a080f6b44bf2b6153f1c4bec, type: 3}
          dialogueType: 1
          line: "Simoun presenting luxurious jewelry to corrupt Spanish friars inside
            a grand colonial hall. The friars\u2019 greedy faces contrast with Simoun\u2019s
            secretive expression. Dramatic lighting, 19th-century realism, political
            tension.\r\n"
      setLocation:
        setLocatoins:
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 1940135251}
          direction: 0
          walk: 1
          camFollow: 0
