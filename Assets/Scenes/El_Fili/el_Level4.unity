  m_Script: {fileID: 11500000, guid: f821fb8e30865e844b03fba045f67a1a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 39 \u2013 Si Simoun"
    sprite: {fileID: -8016225347975602024, guid: 48c05e0276341bf48acf5354fe2643cf, type: 3}
    imageDescription: Mensahe ni Rizal
    description: "Sa huli, ipinahayag ni Rizal na ang tunay na pagbabago ay hindi
      nagmumula sa rebolusyon ng sandata, kundi sa rebolusyon ng isip at puso.\r\nAng
      kabutihan, katalinuhan, at pananampalataya ay siyang tatlong haligi ng makatarungang
      lipunan.\r\nAng mensahe ni Rizal ay malinaw: \u201CAng kalayaan ay walang saysay
      kung hindi ito nakabatay sa kabutihan.\u201D"
  affectedObjects:
    container:
    - {fileID: 1263642969}
  activatedObjects:
    container:
    - {fileID: 125137061}
