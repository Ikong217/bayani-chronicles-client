  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 39 \u2013 Si Simoun"
    sprite: {fileID: -8784477650698931936, guid: 56f1524b7670fb94eae76e818d6f715c, type: 3}
    imageDescription: Ang Pag-amin ni Simoun
    description: "Si Simoun ay walang iba kundi si Crisostomo Ibarra, ang dating
      kabataang puno ng pag-asa.\r\nNgunit sa pagbabalik niya bilang Simoun, dala
      niya ang sugat ng lipunang walang hustisya.\r\nAng kanyang pag-amin kay Padre
      Florentino ay hindi lamang pagkilala sa kanyang nakaraan, kundi tanda ng kanyang
      pagsuko sa Diyos at sa katotohanan.\r\nIto ang sandali ng kanyang moral na
      pagkabuhay\u2014mula sa poot patungo sa kapatawaran."
  affectedObjects:
    container: []
  activatedObjects:
    container: []
