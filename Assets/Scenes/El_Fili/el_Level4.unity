  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 39 \u2013 Si Simoun"
    sprite: {fileID: 2203467670470021903, guid: f5d993c1cf9defd4a86a12709928a453, type: 3}
    imageDescription: Pag-asa sa Bayan
    description: 'Bagaman pumanaw si Simoun, ang kanyang kwento ay nagsilbing binhi
      ng pag-asa para sa mga kabataan.

      Ang kabiguang iyon ay naging paalala
      na ang susunod na henerasyon ay dapat magtaglay ng karunungan, hindi galit.

      Ang
      pag-asa ni Rizal ay nasa kabataang marunong magmahal sa bayan nang may dangal
      at pananampalataya.'
  affectedObjects:
    container: []
  activatedObjects:
    container: []
