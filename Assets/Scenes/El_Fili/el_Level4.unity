  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 39 \u2013 Si Simoun"
    sprite: {fileID: 666633315044439073, guid: 7e7f8c2ccdef02440924548425d070ff, type: 3}
    imageDescription: Aral ng Pagpapatawad
    description: 'Ang kapatawaran ay hindi kahinaan, kundi katapangan.

      Ipinakita
      ni Rizal na ang taong marunong magpatawad ay may lakas na hindi kayang tumbasan
      ng armas o kayamanan.

      Ang aral ni Padre Florentino ay malinaw: kung
      nais nating magbago ang bayan, dapat magsimula ito sa puso.'
  affectedObjects:
    container: []
  activatedObjects:
    container: []
