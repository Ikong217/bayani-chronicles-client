        cycle: 1
        isOneTime: 0
        DeductTime: 0
      eventType: 2
      interval: 0
    - dialogue:
        dialogueLines:
        - characterObj: {fileID: 1415805938}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 0}
          dialogueType: 0
          line: Magandang araw, Bayani! Ngayon ay sisimulan natin ang lima bahagi
            ng iyong paglalakbay sa Noli Me Tangere. Tatalakayin natin ang mahahalagang
            pangyayari mula Kabanata 29 hanggang 36
      setLocation:
        setLocatoins: []
      setEmotes:
        emotions: []
      questions:
        fromDatabase: 0
        questions:
          questions: []
        cycle: 1
        isOneTime: 0
        DeductTime: 0
      eventType: 0
      interval: 0
    - dialogue:
        dialogueLines:
        - characterObj: {fileID: 1415805938}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 0}
          dialogueType: 0
          line: Good day, class!
        - characterObj: {fileID: 1415805938}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 0}
          dialogueType: 0
          line: "Today, we are going to talk about a very interesting and important
            topic \u2014 the thematic analysis of Chapters 1 to 5 of Noli Me Tangere.
            This lesson is important because it helps us understand not only the
            story, but also the social issues and historical realities that Rizal
            wanted to expose during his time"
      setLocation:
        setLocatoins:
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 655418885}
          direction: 0
          walk: 1
          camFollow: 0
          cooldown: 0
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 147887280}
          direction: 0
          walk: 1
          camFollow: 0
          cooldown: 0
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 764581061}
          direction: 0
          walk: 1
          camFollow: 0
          cooldown: 0
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 764581061}
          direction: 2
          walk: 0
          camFollow: 0
          cooldown: 0
      setEmotes:
        emotions: []
      questions:
        fromDatabase: 0
        questions:
          questions: []
        cycle: 1
        isOneTime: 0
        DeductTime: 0
      eventType: 1
      interval: 1
    - dialogue:
        dialogueLines:
        - characterObj: {fileID: 1415805938}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 7096670327494543431, guid: 1189e97e912249f40a9ba9cf596f1aea, type: 3}
          dialogueType: 0
          line: Bayani, narating mo na ang isa sa pinakamadamdaming bahagi ng ating
            paglalakbay. Sa mga kabanatang ito, nasaksihan natin ang pagbagsak ng
            mga pangarap ni Ibarra, ang sakripisyo ni Elias, at ang kawalan ng kalayaan
            ni Maria Clara. Ngunit higit pa rito, unti-unti nang nagigising ang bayan
            sa katotohanang kailangang lumaban para sa katarungan
      setLocation:
        setLocatoins:
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 655418885}
          direction: 0
          walk: 1
          camFollow: 0
          cooldown: 0
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 147887280}
          direction: 0
          walk: 1
          camFollow: 0
          cooldown: 0
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 764581061}
          direction: 0
          walk: 1
          camFollow: 0
          cooldown: 0
      setEmotes:
        emotions: []
      questions:
        fromDatabase: 0
        questions:
          questions: []
        cycle: 1
        isOneTime: 0
        DeductTime: 0
      eventType: 0
      interval: 0
    - dialogue:
        dialogueLines:
        - characterObj: {fileID: 1415805938}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 4146786208365501868, guid: 03759929db966744ca6940b8be86bfd9, type: 3}
          dialogueType: 1
          line: "Ipinakita rito ang pagsira ng mga prayle sa proyekto ni Ibarra \u2014
            isang simbolo ng pagkitil sa pag-asa ng bayan. Pinatunayan nito kung
            paano pinipigilan ng mga nasa kapangyarihan ang edukasyon at pagbabago"
        - characterObj: {fileID: 1415805938}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 1335385452945238478, guid: 46d467eea72a9f6409410c2d3f3acc42, type: 3}
          dialogueType: 1
          line: "Sa kabila ng panganib, tinulungan ni Elias si Ibarra makatakas.
            Ang eksenang ito ay sumisimbolo ng tunay na kabayanihan \u2014 ang sakripisyong
            walang kapalit."
        - characterObj: {fileID: 1415805938}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 4633355498211079068, guid: 10eb2e8e1f8ade7478bb65399537234b, type: 3}
          dialogueType: 1
          line: "Pinili ni Maria Clara na maging madre \u2014 hindi dahil sa bokasyon,
            kundi dahil sa kawalan ng kalayaan. Isa itong tahimik na trahedya ng
            kababaihan sa kolonyal na lipunan"
      setLocation:
        setLocatoins:
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 655418885}
          direction: 0
          walk: 1
          camFollow: 0
          cooldown: 0
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 147887280}
          direction: 0
          walk: 1
          camFollow: 0
          cooldown: 0
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 764581061}
          direction: 0
          walk: 1
          camFollow: 0
          cooldown: 0
      setEmotes:
        emotions: []
      questions:
        fromDatabase: 0
        questions:
          questions: []
        cycle: 1
        isOneTime: 0
        DeductTime: 0
      eventType: 0
      interval: 0
