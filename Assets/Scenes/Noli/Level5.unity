  m_Script: {fileID: 11500000, guid: f821fb8e30865e844b03fba045f67a1a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 13 \u2013 Ang Babala ng Sigwa"
    sprite: {fileID: -8784477650698931936, guid: af149a43363b7ed4fa53fbbec5ad45aa, type: 3}
    imageDescription: Paaralan ni Ibarra
    description: "Ang planong paaralan ni Ibarra ay higit pa sa gusali \u2014 ito
      ay simbolo ng pag-asa, reporma, at pagpapalaya ng isip ng mamamayan. Sa panahong
      kontrolado ng mga prayle ang edukasyon, ipinakita ni Rizal na ang tunay na
      kaalaman ay dapat magmula sa bayan at para sa bayan. Ipinapakita rin nito na
      ang edukasyon ay hindi lamang para sa indibidwal na tagumpay kundi para sa
      kabuuang kalayaan ng bansa."
  affectedObjects:
    container: []
  activatedObjects:
    container:
    - {fileID: 280445190}
