      questions:
        fromDatabase: 0
        questions:
          questions:
          - id: 1
            type: multiple
            question: Sino ang may-akda ng Noli Me Tangere at El Filibusterismo?
            answer: "Dr. Jos\xE9 Rizal"
            otherAnswers:
            - Marcelo H. del Pilar
            - Andres Bonifacio
            - Emilio Aguinaldo
            rationalization: "Si Dr. Jos\xE9 Rizal ang sumulat ng dalawang nobelang
              tumuligsa sa pang-aabuso ng mga Espanyol sa Pilipinas. Ang Noli Me
              Tangere ay naglalantad ng sakit ng lipunan, samantalang ang El Filibusterismo
              ay tumutuligsa sa katiwalian at nananawagan ng pagbabago."
          - id: 2
            type: tof
            question: Si Andres Bonifacio ang may-akda ng Noli Me Tangere at El Filibusterismo.
            answer: false
            otherAnswers:
            - Juan Luna
            - Andres Bonifacio
            - Julian Felipe
            rationalization: "Ang may-akda ng Noli Me Tangere at El Filibusterismo
              ay si Dr. Jos\xE9 P. Rizal, hindi si Andres Bonifacio. Si Bonifacio
              ay isa sa mga rebolusyonaryong inspiradong kumilos matapos mabasa ang
              mga akda ni Rizal."
          - id: 2
            type: identification
            question: Siya ang Pilipinong may-akda ng Noli Me Tangere at El Filibusterismo
              na tinaguriang pambansang bayani ng Pilipinas.
            answer: Dr. Jose Rizal
            otherAnswers:
            - Juan Luna
            - Andres Bonifacio
            - Julian Felipe
            rationalization: "Ang may-akda ng Noli Me Tangere at El Filibusterismo
              ay si Dr. Jos\xE9 P. Rizal, hindi si Andres Bonifacio. Si Bonifacio
              ay isa sa mga rebolusyonaryong inspiradong kumilos matapos mabasa ang
              mga akda ni Rizal."
