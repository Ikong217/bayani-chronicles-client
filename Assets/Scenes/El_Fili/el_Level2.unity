    - characterObj: {fileID: 0}
      player: 0
      cameraFollow: 0
      sprite: {fileID: -4246156734027616742, guid: 60954b2a317e11b41a70cb1bf7c175e0, type: 3}
      dialogueType: 1
      line: 'Si Basilio ay kumakatawan sa pag-asa ng kabataan at sa paniniwala ni
        Rizal na ang edukasyon ay sandata laban sa pang-aapi. Sa kabila ng kahirapan,
        ipinagpatuloy niya ang pag-aaral upang makapaglingkod sa bayan. Sa pamamagitan
        ni Basilio, ipinapaalala ni Rizal na ang tunay na pagbabago ay nagmumula
        sa karunungan at kabutihang-asal.

'
  required: 1
  reusable: 0
  affectedObjects:
    container: []
  activateObjects:
    container:
    - {fileID: 234913301}
