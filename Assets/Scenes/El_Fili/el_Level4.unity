  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 38 \u2013 Ang Alahas"
    sprite: {fileID: -4246156734027616742, guid: d4b12240b11073a468c8955bb1ff8d34, type: 3}
    imageDescription: Ang Alahas at Kasakiman
    description: "Ang mga alahas ni Simoun ay simbolo ng tukso ng kapangyarihan at
      kasakiman.\r\nIto ang naging sandata niya sa paghihiganti, ngunit sa huli,
      ito rin ang naging sanhi ng kanyang pagbagsak.\r\nIpinakita ni Rizal na ang
      kayamanan, kung gagamitin sa kasamaan, ay walang saysay\u2014sapagkat ang tunay
      na ginto ay ang kabutihan ng puso."
  affectedObjects:
    container: []
  activatedObjects:
    container: []
