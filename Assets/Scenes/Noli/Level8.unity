  scrollContent:
    title: "Kabanata 25 \u2013 Sa Bahay ng Pilosopo"
    sprite: {fileID: -8784477650698931936, guid: 9037aacaf81362946be6ce6d0a1fbb7e, type: 3}
    imageDescription: Pagbabalik ni Ibarra
    description: Ang pagbabalik ni Ibarra ay simbolo ng bagong pag-asa para sa bayan.
      Hindi lamang ito literal na pagbalik, kundi isang simbolo ng determinasyon,
      tapang, at paninindigan laban sa pang-aapi. Sa kanyang muling pagtindig, ipinapakita
      na ang tunay na bayani ay may puso at prinsipyo na hindi kayang pawiin ng takot
      o kabiguan.
  affectedObjects:
    container: []
  activatedObjects:
    container:
    - {fileID: 1599744472}
