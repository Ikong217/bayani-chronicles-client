  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 39 \u2013 Si Simoun"
    sprite: {fileID: -5925851634452128385, guid: 5f0511633aad7804b81d47a086451db9, type: 3}
    imageDescription: 'Padre Florentino: Tinig ng Pananampalataya'
    description: 'Si Padre Florentino ay larawan ng Simbahang tunay sa diwa ng kabutihan.

      Sa
      kanya, ipinahayag ni Rizal ang pananampalatayang hindi bulag, kundi nakabatay
      sa katwiran at pagmamahal sa bayan.

      Ang kanyang payo kay Simoun ay
      paalala na walang rebolusyon ang magtatagumpay kung walang moral na direksyon.'
  affectedObjects:
    container: []
  activatedObjects:
    container: []
