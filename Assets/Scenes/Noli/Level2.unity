  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 7 \u2013 Idyll sa Isang Asotea"
    sprite: {fileID: -8784477650698931936, guid: bc8508fef3bb2c843bc13f2fb4a2fe0e, type: 3}
    imageDescription: Payo ni Tasyo
    description: Si Pilosopo Tasyo ay matalinong tagapayo ng bayan ng San Diego.
      Ang kanyang payo kay Ibarra ay nakatuon sa tamang landas ng edukasyon at reporma.
      Ipinapakita rito kung paano ang kaalaman at karunungan ay mahalagang gabay
      sa paggawa ng makatarungan at makabuluhang desisyon, lalo na sa harap ng kolonyal
      na pamamahala.
  affectedObjects:
    container: []
  activatedObjects:
    container: []
