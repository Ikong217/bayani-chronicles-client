  m_Script: {fileID: 11500000, guid: f821fb8e30865e844b03fba045f67a1a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: " Kabanata 25 \u2013 Sa Bahay ng Pilosopo"
    sprite: {fileID: -5925851634452128385, guid: 1058c28d4e111a949954fd2f90a9fc32, type: 3}
    imageDescription: 'Pag-alis ni Ibarra '
    description: "Ang pag-alis ni Ibarra ay hindi pagtakas mula sa problema. Sa mas
      malalim na kahulugan, ito ay paglayo upang mabuhay pa siya at baka, balang
      araw, makahanap ng mas mabuting paraan upang ituloy ang laban. Pinapakita ni
      Rizal na minsan, ang pag-alis ay paraan para maghilom, maghanda, at magbalik
      na mas matatag. Ang paglayag niya papalayo ay parang paglayag ng pag-asa\u2014mahina
      pa, pero buhay.\r\n"
  affectedObjects:
    container: []
  activatedObjects:
    container: []
