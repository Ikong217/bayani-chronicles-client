  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 1 \u2013 Sa Ibabaw ng Kubyerta"
    sprite: {fileID: -8784477650698931936, guid: 2b8f3cadec13fad488416190016dee54, type: 3}
    imageDescription: Simoun sa Kuwento ng Alahero
    description: "Si Simoun ay walang iba kundi si Crisostomo Ibarra \u2014 ang idealistang
      binata mula sa Noli Me Tangere na nabigo dahil sa katiwalian ng lipunan at
      simbahan. Sa El Filibusterismo, bumalik siya bilang isang misteryosong alahero
      upang maghiganti. Ang kanyang pagbabalik ay simbolo ng radikal na pagbabago
      ng puso at kaisipan \u2014 mula sa edukasyon tungo sa rebolusyon."
  affectedObjects:
    container: []
  activatedObjects:
    container: []
