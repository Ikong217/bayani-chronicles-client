  scrollContent:
    title: "Kabanata 39 \u2013 Si Simoun"
    sprite: {fileID: -4246156734027616742, guid: 167854df81df1934d8d2eacee5c6eeaa, type: 3}
    imageDescription: Ang Dagat ng Pag-asa
    description: "Matapos mamatay si Simoun, inihagis ni Padre Florentino sa dagat
      ang mga alahas\u2014isang simbolo ng kasakiman at karahasan. Ang dagat dito
      ay kumakatawan sa paglilinis, kapatawaran, at bagong pag-asa. Sa pagdaloy ng
      tubig, ipinakita ni Rizal ang panibagong simula para sa bayan."
  affectedObjects:
    container: []
  activatedObjects:
    container: []
