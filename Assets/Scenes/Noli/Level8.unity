  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: " Kabanata 10 \u2013 Ang Bayan"
    sprite: {fileID: 2882146333287477088, guid: b3bd11581a2734c4eaf55335e9638b59, type: 3}
    imageDescription: Pagtutulungan ng Masa
    description: 'Pamagat ng Larawan: Pagtutulungan ng Masa

      Ang pagtutulungan
      ng mga tao sa bayan ay sumasalamin sa katatagan at pagkakaisa ng masa. Kahit
      mahirap at simple, ang kanilang ambag sa bayan ay mahalaga at nagbubunga ng
      pagbabago. Ipinapakita nito na ang kabayanihan ay hindi lamang sa may kapangyarihan,
      kundi sa bawat tao na handang magsakripisyo para sa ikabubuti ng nakararami.'
  affectedObjects:
    container: []
  activatedObjects:
    container: []
