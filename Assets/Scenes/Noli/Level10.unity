  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 62 \u2013 Sa Kumbento"
    sprite: {fileID: 2203467670470021903, guid: cf92278abea7c1e4d81a0c6105ce6249, type: 3}
    imageDescription: Kalayaan ni Maria Clara
    description: "Ang pagkawala ng kalayaan ni Maria Clara ay hindi lamang dahil
      sa pisikal na mga pader ng kumbento. Ito ay mas malalim\u2014pader ng lipunan,
      pader ng obligasyon, pader ng utang na loob, at pader ng takot. Pinapakita
      ni Rizal na ang kababaihang Pilipino noong panahong iyon ay bihag ng mga desisyong
      hindi kanila, at ang pagkabilanggo ni Maria Clara ay naging mukha ng libo-libong
      babaeng walang boses."
  affectedObjects:
    container: []
  activatedObjects:
    container: []
