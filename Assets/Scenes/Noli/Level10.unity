  m_Script: {fileID: 11500000, guid: f821fb8e30865e844b03fba045f67a1a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 64 \u2013 Wakas"
    sprite: {fileID: -8973685433085253168, guid: 2add6aa1d33d7da48a83e509dc791e27, type: 3}
    imageDescription: Simbolismo ng Pasko
    description: "Ginamit ni Rizal ang Bisperas ng Pasko bilang makapangyarihang
      simbolo. Sa kultura ng Pilipino, ang Pasko ay pagdiriwang ng pag-asa, kapayapaan,
      at bagong simula. Kaya nang piliin niyang tapusin ang nobela sa eksenang ito,
      ipinapakita niyang kahit madilim at malungkot ang tinahak ng mga tauhan, may
      sinag pa rin ng pag-asa para sa bayan. Ang ilaw ng kandila sa sementeryo ay
      hindi lang liwanag\u2014kundi paniniwalang may bukas pa."
  affectedObjects:
    container: []
  activatedObjects:
    container: []
