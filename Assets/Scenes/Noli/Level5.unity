  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 39 \u2013 Wakas"
    sprite: {fileID: -8973685433085253168, guid: 2f80a957e0ca99e4c969a8c263d61d42, type: 3}
    imageDescription: Kamatayan ni Elias
    description: "Ang pagkamatay ni Elias ay tila trahedya, ngunit ito rin ay simbolo
      ng pagbubukang-liwayway ng rebolusyon. Sa kanyang pagpanaw sa lawa, iniwan
      niya ang mensahe ng sakripisyo at pag-asa \u2014 na kahit mawala ang tao, mananatili
      ang kanyang adhikain. Ang tubig ng lawa ay tila sinaniban ng diwa ng pagbabago
      na magpapatuloy sa mga susunod na henerasyon."
  affectedObjects:
    container: []
  activatedObjects:
    container: []
