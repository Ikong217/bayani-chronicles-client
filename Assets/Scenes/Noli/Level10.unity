  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 64 \u2013 Wakas"
    sprite: {fileID: 5931915480054915164, guid: 86e5965563f5fac4bbb824347830edf5, type: 3}
    imageDescription: Bayan na Sugatan
    description: "Matapos ang mga kaguluhang naganap, ang San Diego ay naging isang
      bayan na nabalot ng katahimikan\u2014hindi dahil payapa, kundi dahil sugatan.
      Ang tahimik na kalye, ang mga saradong bahay, at ang tila malamig na hangin
      ay naglalarawan ng komunidad na hindi pa handang humarap sa sarili nitong mga
      kasalanan. Tila hinayaan ng nobela na magmuni ang bayan, dahil minsan ang katahimikan
      ang pinakamalakas na pagsisisi."
  affectedObjects:
    container:
    - {fileID: 1126366125}
  activatedObjects:
    container:
    - {fileID: 1128718480}
