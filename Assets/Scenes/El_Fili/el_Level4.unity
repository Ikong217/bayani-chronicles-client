  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 39 \u2013 Si Simoun"
    sprite: {fileID: -6455050014841698326, guid: be79fafc46c4bfa40bf15f68402ea494, type: 3}
    imageDescription: Liwanag ng Katotohanan
    description: "Sa pagitan ng dilim ng galit at liwanag ng kapatawaran, pumili
      si Rizal ng katotohanan.\r\nAng liwanag sa dagat ay sumisimbolo sa kaliwanagan
      ng isip\u2014ang pagbubukas ng mata ng bayan sa tunay na kahulugan ng hustisya.\r\nIto
      ang paalala ni Rizal na kahit sa kadiliman ng kolonyalismo, may ilaw na hindi
      kailanman mapapatay."
  affectedObjects:
    container: []
  activatedObjects:
    container: []
