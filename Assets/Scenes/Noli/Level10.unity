  m_Script: {fileID: 11500000, guid: f821fb8e30865e844b03fba045f67a1a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 62 \u2013 Sa Kumbento"
    sprite: {fileID: 2882146333287477088, guid: 593e11391fb15e84fbc7fb30264a26da, type: 3}
    imageDescription: Maria Clara at ang Kalungkutang Hindi Nakikita
    description: "Sa likod ng makakapal na pader ng kumbento, hindi nakikita ng tao
      ang tunay na bigat ng kalungkutan ni Maria Clara. Ang pagpasok niya sa kumbento
      ay hindi desisyon ng puso, kundi bunga ng takot, pang-aabuso ng kapangyarihan,
      at pag-manipula ng mga taong mas may impluwensya kaysa sa kanya. Ipinakita
      ni Rizal na maraming kababaihan noon ang nabubuhay sa \u201Ctahimik na lungkot\u201D\u2014walang
      boses, walang sariling desisyon, at walang kontrol sa sariling kapalaran."
  affectedObjects:
    container: []
  activatedObjects:
    container: []
