  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 11 \u2013 Ang mga Makapangyarihan"
    sprite: {fileID: 666633315044439073, guid: 9edd6c279723ecd43b861535c112cfcf, type: 3}
    imageDescription: Yaman at Posisyon
    description: Ang mga mayayamang mamamayan ay puwedeng makialam sa proyekto ni
      Ibarra, ngunit ang tunay na pagbabago ay nanggagaling sa pagtutulungan, karunungan,
      at tamang prinsipyo. Pinapakita nito ang tension sa pagitan ng yaman, impluwensya,
      at moralidad sa lipunan.
  affectedObjects:
    container: []
  activatedObjects:
    container: []
