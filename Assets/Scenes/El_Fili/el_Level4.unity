  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 39 \u2013 Si Simoun"
    sprite: {fileID: 2882146333287477088, guid: 1873140db0b88d9498e2497e17f8dbf1, type: 3}
    imageDescription: Ang Pagtubos ng Kaluluwa
    description: "Sa pagkamatay ni Simoun, nakita natin ang pagtubos ng isang kaluluwang
      naligaw ng galit.\r\nHabang siya\u2019y humihinga ng huling sandali, ipinakita
      ni Rizal na walang huli para magbago.\r\nAng kapatawaran, ayon kay Padre Florentino,
      ay nagbibigay-laya hindi lamang sa mga nasaktan kundi pati sa mga nakasala.\r\n"
  affectedObjects:
    container: []
  activatedObjects:
    container: []
