  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 39 \u2013 Si Simoun"
    sprite: {fileID: -8784477650698931936, guid: 58b8977dea30ccd41a697d2e281cfdb0, type: 3}
    imageDescription: Ang Pagbabalik-Loob ni Simoun
    description: Sa huling bahagi ng nobela, si Simoun (Crisostomo Ibarra) ay tuluyang
      nagsisi sa kanyang mga ginawa. Ang kanyang pagnanais na baguhin ang lipunan
      sa pamamagitan ng karahasan ay nauwi sa pagkabigo. Sa kanyang pagkamatay, natutunan
      niya na ang tunay na pagbabago ay hindi nakukuha sa paghihiganti, kundi sa
      kabutihan at pagpapatawad. Ipinakita ni Rizal na kahit ang pusong puno ng galit
      ay may pagkakataong magbago kung pipiliin ang tama.
  affectedObjects:
    container: []
  activatedObjects:
    container: []
