  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 15 \u2013 Se\xF1or Pasta"
    sprite: {fileID: -4246156734027616742, guid: 76cbb5220219979468bd66165b86d568, type: 3}
    imageDescription: Kabataang Naglalakbay sa Kaalaman
    description: "Sa El Filibusterismo, sina Isagani at Basilio ay mga kabataang
      naniniwala sa kapangyarihan ng edukasyon. Pinaglalaban nila ang pagtatayo ng
      isang Academia de Castellano \u2014 paaralang magtuturo ng wikang Espanyol
      para magkaroon ng pantay na karapatan sa lipunan. Ngunit ipinakita ni Rizal
      na kahit ang edukasyon ay madaling magamit ng mga may kapangyarihan kung walang
      moral na pundasyon."
  affectedObjects:
    container: []
  activatedObjects:
    container: []
