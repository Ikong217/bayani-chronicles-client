    - dialogue:
        dialogueLines:
        - characterObj: {fileID: 8485366}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 7096670327494543431, guid: 1189e97e912249f40a9ba9cf596f1aea, type: 3}
          dialogueType: 0
          line: Ito na ang pagtatapos ng ating talakayan.
        - characterObj: {fileID: 8485366}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 7096670327494543431, guid: 1189e97e912249f40a9ba9cf596f1aea, type: 3}
          dialogueType: 0
          line: 'Ngayon ay kailangan mong hanapin ang 10 nakatagong scrolls.

            Bawat
            pergamino ay naglalaman ng trivia mula sa Kabanata 1 hanggang 5.

            Kolektahin
            mo silang lahat upang ma-unlock ang pagsusulit na magpapatunay ng iyong
            mga natutunan.'
      setLocation:
        setLocatoins:
        - player: 1
