  m_Name: 
  m_EditorClassIdentifier: 
  scrollContent:
    title: "Kabanata 23 \u2013 Isang Bangkay"
    sprite: {fileID: -8784477650698931936, guid: 2566167331023aa44a51bc267868741b, type: 3}
    imageDescription: Elias at Ibarra
    description: "Ang pagkikita nina Elias at Ibarra ay hindi lang simpleng usapan;
      ito\u2019y representasyon ng dalawang uri ng kabayanihan. Si Elias ay kumakatawan
      sa mga api at naghihirap na handang ipaglaban ang kalayaan kahit sa marahas
      na paraan, samantalang si Ibarra ay kumakatawan sa edukadong Pilipino na naniniwala
      sa reporma. Ipinakita ni Rizal na ang tunay na pagbabago ay nangangailangan
      ng balanse \u2014 karunungan ng isip at tapang ng puso."
  affectedObjects:
    container: []
  activatedObjects:
    container: []
