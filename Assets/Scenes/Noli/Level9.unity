        cycle: 1
        isOneTime: 0
        DeductTime: 0
      eventType: 2
      interval: 0
    - dialogue:
        dialogueLines:
        - characterObj: {fileID: 1868826426}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 0}
          dialogueType: 0
          line: Bayani, narating mo na ang huling yugto ng ating paglalakbay sa nobela.
            Sa mga kabanatang ito, nasaksihan natin ang matinding sakripisyo ni Elias,
            ang mapait na desisyon ni Maria Clara na maging madre, at ang mga tahimik
            na bayani sa likod ng mga pangyayari.
      setLocation:
        setLocatoins: []
      setEmotes:
        emotions: []
      questions:
        fromDatabase: 0
        questions:
          questions: []
        cycle: 1
        isOneTime: 0
        DeductTime: 0
      eventType: 0
      interval: 0
    - dialogue:
        dialogueLines:
        - characterObj: {fileID: 1868826426}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 0}
          dialogueType: 0
          line: Good day, class!
        - characterObj: {fileID: 1868826426}
          player: 0
          cameraFollow: 1
          sprite: {fileID: 0}
          dialogueType: 0
          line: "Today, we are going to talk about a very interesting and important
            topic \u2014 the thematic analysis of Chapters 1 to 5 of Noli Me Tangere.
            This lesson is important because it helps us understand not only the
            story, but also the social issues and historical realities that Rizal
            wanted to expose during his time"
      setLocation:
        setLocatoins:
        - player: 1
          character: {fileID: 0}
          tartgetLocation: {fileID: 1486509658}
          direction: 0
          walk: 1
          camFollow: 0
          cooldown: 0
        - player: 1
          character: {fileID: 0}
